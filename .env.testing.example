# Copy this file to .env.testing and set the user and password of a MySQL user that may create tables in
# DB_DATABASE (create that database first: it is emptied by every run of the tests, never use a real one).
APP_NAME="Transcription Platform"
APP_ENV=testing
APP_KEY=base64:/jLYJjBahgsVINBPzztPmKYkpaoXEeS181XvLbNhcjY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=transcription_testing
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

# Feature tests never hit the real Specify API; leave these unset.
API_USERNAME=
API_PASSWORD=
API_URL=
