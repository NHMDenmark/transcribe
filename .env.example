APP_NAME="Transcription Platform"
APP_ENV=local
# generated by php artisan platform:install (or php artisan key:generate): never share it
APP_KEY=
# true shows technical errors to visitors: use false on a server
APP_DEBUG=true

# APP_URL must be the full public URL as seen by the browser,
# including any sub-path imposed by a reverse proxy.
# Examples:
#   Direct:         APP_URL=http://localhost
#   Reverse proxy:  APP_URL=https://transcription.example.org
# When APP_URL starts with https:// every address the application builds (forms, links, redirects)
# is https://, even if the proxy that ends the HTTPS is not recognised (see TRUST_PROXIES below).
# Without it a form would post to http:// and a proxy that only accepts https would answer with a
# redirect, losing what was typed (a login that does nothing).
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=transcription
DB_USERNAME=root
DB_PASSWORD=

# Connection to the collection database the data is synced to (Specify 7); leave empty if you do not sync.
# API_URL is the address of the Specify 7 server, and the user is one that may write to the collection.
API_URL=
API_USERNAME=
API_PASSWORD=
# The id of the Specify collection that user logs in to (Specify asks for it when signing in).
API_COLLECTION=

# The transcription form shows 'all' fields of a specimen at once, or 'single': one field per screen.
# A project, and then each user, can choose differently; this is the default of a new project.
FIELD_VIEW_DEFAULT=all

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---------------------------------------------------------------
# PROXY / REVERSE PROXY CONFIGURATION
# ---------------------------------------------------------------
# Leave TRUST_PROXIES unset for direct deployments (no proxy).
# Set to * to trust all proxies (SSH tunnel, reverse proxy, etc).
# Set to a comma-separated list of IPs to trust specific proxies.
# Examples:
#   TRUST_PROXIES=*
#   TRUST_PROXIES=192.168.1.1,10.0.0.1
TRUST_PROXIES=

# ---------------------------------------------------------------
# SESSION COOKIE CONFIGURATION
# ---------------------------------------------------------------
# For deployments behind HTTPS reverse proxies, set:
#   SESSION_SECURE_COOKIE=true
#   SESSION_DOMAIN=.your-domain.com  (leading dot covers subdomains)
# For local/HTTP development, leave both unset.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# the address the mail is sent from (required: without it a password request fails)
MAIL_FROM_ADDRESS=noreply@example.org
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"
